{
  "name": "mcp-brain",
  "version": "1.1.0",
  "description": "MCP server for searching, reading, linking, and safely updating the local brain Markdown wiki",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brain-lint": "dist/cli.js",
    "brain-index": "dist/index-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "openai": "^6.37.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.8.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.18",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
