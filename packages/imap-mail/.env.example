# One IMAP account per deployed instance — add a new mcp.json entry per account,
# each with its own env block (see README.md "Adding an account").

# IMAP host, e.g. imap.gmail.com / imap.qq.com
IMAP_MCP_HOST=

# IMAP port. 993 (implicit TLS) is standard and the default if unset.
IMAP_MCP_PORT=993

# Full email address to log in with.
IMAP_MCP_USER=

# App password / authorization code — NEVER your normal account password.
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
# QQ Mail: Settings -> Account -> POP3/IMAP/SMTP -> generate authorization code
IMAP_MCP_PASSWORD=

# Friendly name shown in tool output and error messages, e.g. "Gmail" or "QQ Mail".
IMAP_MCP_LABEL=
