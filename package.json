{
  "name": "mcp-servers",
  "version": "1.0.0",
  "private": true,
  "description": "Personal MCP servers monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:applemail": "npm run build -w packages/applemail",
    "build:brain-mcp": "npm run build -w packages/brain-mcp",
    "build:teams-chat": "npm run build -w packages/teams-chat",
    "build:outlook": "npm run build -w packages/outlook",
    "build:discord-user": "npm run build -w packages/discord-user",
    "build:flywheel": "npm run build -w packages/flywheel",
    "build:ms-loop": "npm run build -w packages/ms-loop",
    "build:worker-center-mcp": "npm run build -w packages/worker-center-mcp",
    "build:imap-mail": "npm run build -w packages/imap-mail"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
